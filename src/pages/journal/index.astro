---
import MainLayout from '../../layouts/MainLayout.astro';
import { DreamList } from '../../components/DreamList';
---

<MainLayout title="Dream Journal">
  <div class="journal-header">
    <h1>Your Dream Journal</h1>
    <p>Explore your collection of recorded dreams</p>
    <a href="/" class="new-dream-btn">Log a New Dream</a>
  </div>
  
  <DreamList client:load />
</MainLayout>

<script>
  import { setupCardGlow } from '../../scripts/cardGlow';
  
  // Run after component hydration
  document.addEventListener('astro:page-load', () => {
    setupCardGlow();
  });
</script>

<style>
  .journal-header {
    text-align: center;
    margin: 4rem 0;
  }
  
  h1 {
    font-size: 2.5rem;
    background: linear-gradient(135deg, var(--accent-color), #c77dff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
  }
  
  p {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto 2rem;
    color: rgba(224, 224, 255, 0.9);
  }
  
  .new-dream-btn {
    display: inline-block;
    background: var(--accent-color);
    color: white;
    padding: 0.75rem 2rem;
    border-radius: 2rem;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }
  
  .new-dream-btn:hover {
    background: var(--secondary-color);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(157, 78, 221, 0.3);
  }
</style>