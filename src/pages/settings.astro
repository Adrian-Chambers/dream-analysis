---
import MainLayout from '../layouts/MainLayout.astro';
import { DataManager } from '../components/DataManager';
---

<MainLayout title="Settings">
  <div class="settings-page">
    <h1>Settings</h1>
    <p>Manage your dream journal data and preferences</p>
    
    <DataManager client:load />
    
    <div class="storage-info">
      <h3>About Local Storage</h3>
      <p>
        Your dream journal data is stored locally in your browser using IndexedDB.
        This means your dreams are private and never leave your device, but also means
        that clearing your browser data will erase your dream journal.
      </p>
      <p>
        We recommend regularly exporting your dreams as a backup.
      </p>
    </div>
  </div>
</MainLayout>

<style>
  .settings-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  
  h1 {
    font-size: 2.5rem;
    background: linear-gradient(135deg, var(--accent-color), #c77dff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
  }
  
  p {
    font-size: 1.125rem;
    color: rgba(224, 224, 255, 0.9);
    margin-bottom: 2rem;
  }
  
  .storage-info {
    margin-top: 3rem;
    background: rgba(15, 15, 30, 0.5);
    padding: 2rem;
    border-radius: 1rem;
  }
  
  .storage-info h3 {
    font-size: 1.25rem;
    color: var(--accent-color);
    margin-bottom: 1rem;
  }
  
  .storage-info p {
    font-size: 1rem;
    margin-bottom: 1rem;
  }
</style>